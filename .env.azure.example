# ============================================================================
# APUESTADB - .env.azure.example
# Copiar a .env.azure (ignorado por Git) y completar SIN versionar valores.
# ============================================================================

# --- Puerta de entrada ---
# En la VM de Azure usar 80. Para pruebas locales se puede dejar 8080.
NGINX_PORT=8080
CORS_ORIGINS=http://localhost:8080

# --- JWT (32+ caracteres aleatorios) ---
JWT_SECRET=<cadena-aleatoria-de-32-o-mas-caracteres>

# --- SQL Server ---
SQLSERVER_SA_PASSWORD=<contrasena-fuerte-sa>

# --- MySQL ---
MYSQL_ROOT_PASSWORD=<contrasena-root-mysql>
MYSQL_DATABASE=apuestadb
MYSQL_USER=apuestadb_app
MYSQL_PASSWORD=<contrasena-app-mysql>

# --- PostgreSQL ---
POSTGRES_USER=apuestadb_app
POSTGRES_PASSWORD=<contrasena-app-postgres>
POSTGRES_DB=apuestadb

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=apuestadb_app
MONGO_INITDB_ROOT_PASSWORD=<contrasena-app-mongo>

# --- Motores del backend ---
CATALOGO_MOTOR=mysql
SALDO_MOTOR=postgresql
APUESTAS_MOTOR=mongodb
DOCUMENTOS_MOTOR=mongodb
