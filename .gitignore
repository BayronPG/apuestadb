# =============================================
# ApuestaDB — .gitignore
# =============================================

# --- Dependencias y compilación (frontend) ---
node_modules/
dist/

# --- Perfil temporal del navegador (capturas de maquetas) ---
docs/mockups/.tmp-profile/

# --- Archivos internos de OpenClaw (no son parte del proyecto) ---
openclaw-workspace-state.json*
HEARTBEAT.md
AGENTS.md
SOUL.md
IDENTITY.md
USER.md
TOOLS.md
AGENT_INSTRUCTIONS.md
MEMORY.md
DREAMS.md
memory/

# --- Credenciales y respaldos (nunca versionar) ---
.env
**/.env
*.bak
docs/base_datos/backups/

# --- Sistema ---
.DS_Store
Thumbs.db
*.log

# --- Artefactos locales de trabajo ---
.tmp/
media/inbound/
