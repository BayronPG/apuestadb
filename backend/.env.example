# =============================================================================
# ApuestaDB - Backend / Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# 1. Copie este archivo como ".env" (el .env esta ignorado por git).
# 2. Reemplace TODOS los marcadores <...> por valores reales del entorno local.
# 3. NUNCA escriba credenciales reales en este archivo ni en el repositorio.
# =============================================================================

# --- Entorno de ejecucion ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Origen(es) permitidos por CORS (el frontend React). Use "*" solo en desarrollo.
CORS_ORIGIN=http://localhost:5173

# --- Seguridad / JWT ---
# Cadena aleatoria de 32 caracteres o mas. Genere una propia; no reutilice la de ejemplo.
JWT_SECRET=<cadena-aleatoria-de-32-o-mas-caracteres>
JWT_EXPIRES_IN=2h
JWT_ISSUER=apuestadb-api
# Rondas de costo de bcrypt (10 por decision del proyecto).
BCRYPT_ROUNDS=10
AUDIT_ACCESS=true

# --- SQL Server ---
DB_SERVER=localhost\SQLEXPRESS01
DB_PORT=1433
DB_NAME=ApuestaDB
DB_USER=<usuario-de-base-de-datos>
DB_PASSWORD=<contrasena-de-base-de-datos>
# sql = autenticacion SQL (por defecto) | windows = autenticacion integrada
DB_AUTH_MODE=sql
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_CONNECT_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# --- Registro ---
LOG_LEVEL=info

# --- Catalogo (Fase 15) ---
# 'sqlserver' (predeterminado) o 'mysql'. Define el motor de lectura del
# catalogo deportivo y de los eventos.
CATALOGO_MOTOR=sqlserver

# --- Saldo (Fase 16) ---
# 'sqlserver' (predeterminado) o 'postgresql'. Define el motor de LECTURA del
# dominio financiero. Las escrituras siguen en SQL Server.
SALDO_MOTOR=sqlserver

# --- Motores auxiliares (Fase 14.5) ---
# SQL Server sigue siendo el motor funcional; estas conexiones solo alimentan
# GET /api/health. Si faltan, el motor aparece como "no_disponible".
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=apuestadb
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT=5000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=apuestadb
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=5000

# URI completa de MongoDB. No versionar valores reales.
MONGO_URI=mongodb://usuario:password@localhost:27017
MONGO_DATABASE=apuestadb
MONGO_CONNECT_TIMEOUT=5000
