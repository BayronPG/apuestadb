# ============================================================
# ApuestaDB backend - variables de entorno (ejemplo)
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio (esta en .gitignore).
# ============================================================

# Puerto del backend (Express)
PORT=3000

# Conexion a SQL Server (host y puerto por separado)
DB_SERVER=localhost
DB_PORT=1433

# Nombre de la base de datos
DB_NAME=ApuestaDB

# Login SQL dedicado para la aplicacion (creado con permisos db_owner
# sobre ApuestaDB). NO se usa autenticacion de Windows desde Node.
DB_USER=apuestadb_app
DB_PASSWORD=cambia_esta_clave

# Secreto para firmar la cookie de sesion (genera uno aleatorio largo)
SESSION_SECRET=cambia_este_secreto_largo

# Clave de pruebas del usuario admin sembrado (solo sandbox local).
# La bateria (npm run pruebas) la aplica como hash bcrypt sobre el usuario
# jhon@apuestadb.com para poder probar el flujo de administrador y luego
# permite iniciar sesion manualmente en la UI. Pon aqui tu propia clave.
PRUEBA_CLAVE_ADMIN=cambia_esta_clave_de_pruebas
