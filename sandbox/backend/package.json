{
  "name": "apuestadb-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend sandbox academico de ApuestaDB (Node.js + Express + SQL Server). Autenticacion con sesion en cookie httpOnly y registro con bcrypt.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pruebas": "node scripts/pruebas_api.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
