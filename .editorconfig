# Configuración base del proyecto (compatible con VS Code, Cursor y otros editores)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = crlf

[*.{js,jsx,mjs,json,md,css,html}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
